---
import VideoClip from "./VideoClip.astro";

/** Section sur fond bleu nuit : texte à gauche, une vidéo verticale à droite. */
interface Props {
  id: string;
  title: string;
  text: string;
  pills?: string[];
  video: { src: string; poster: string; title: string; caption?: string };
}
const { id, title, text, pills = [], video } = Astro.props;
---

<section class="on-dark bg-navy-900 text-white" aria-labelledby={id}>
  <div
    class="wrap section-y grid items-center gap-[clamp(28px,4vw,72px)] md:grid-cols-[minmax(0,1fr)_minmax(0,300px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)]"
  >
    <div class="flex flex-col gap-[18px]">
      <span class="eyebrow">En vidéo</span>
      <h2 id={id} class="h2-sm">{title}</h2>
      <p class="max-w-[32em] text-[17px] leading-[1.55] text-on-navy">{text}</p>
      {
        pills.length > 0 && (
          <ul class="flex flex-wrap gap-2.5">
            {pills.map((p) => (
              <li class="pill" data-sr>
                {p}
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <VideoClip
      src={video.src}
      poster={video.poster}
      title={video.title}
      caption={video.caption}
      class="mx-auto w-full max-w-[300px] md:max-w-none"
    />
  </div>
</section>
