---
import { site } from "@/data/site";

/** Communes desservies : texte à gauche, liste en colonnes à droite (SEO local). */
const cities = [...site.cities].sort((a, b) => a.name.localeCompare(b.name, "fr"));
---

<section class="border-t border-line-2 bg-sand" aria-labelledby="zones-titre">
  <div class="wrap section-y grid items-start gap-[clamp(28px,4vw,64px)] lg:grid-cols-[minmax(0,0.9fr)_minmax(0,2fr)]">
    <div class="flex flex-col gap-4">
      <span class="eyebrow">Zones d'intervention</span>
      <h2 id="zones-titre" class="h2-sm">Couvreur dans l'Oise, près de chez vous</h2>
      <p class="text-[17px] leading-[1.55] text-ink-3">
        Basés à Mogneville, nous intervenons autour de Creil, Liancourt, Beauvais et Chantilly. Cette liste
        n'est pas exhaustive : si votre commune n'y figure pas, appelez-nous pour vérifier.
      </p>
      <a href={site.phoneHref} class="btn btn-navy mt-1 w-max px-[22px] py-[13px] text-base">
        Vérifier ma commune — {site.phone}
      </a>
    </div>

    <ul class="columns-2 gap-x-5 sm:columns-3 sm:gap-x-8" aria-label="Communes desservies (liste non exhaustive)">
      {
        cities.map((c) => (
          <li class="flex break-inside-avoid items-baseline gap-2.5 border-b border-line-2 py-3" data-sr>
            <svg viewBox="0 0 24 24" class="size-4 flex-none translate-y-0.5 text-accent" fill="currentColor" aria-hidden="true">
              <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
            </svg>
            <span class="font-display text-[14.5px] font-semibold text-ink sm:text-[15.5px]">{c.name}</span>
            <span class="ml-auto hidden text-[13.5px] text-muted sm:inline">{c.postalCode}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
