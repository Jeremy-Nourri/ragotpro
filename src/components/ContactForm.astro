---
import { site } from "@/data/site";

/**
 * Formulaire de devis détaillé (page Contact).
 * Envoi en POST vers PUBLIC_FORM_ENDPOINT (Formspree, Web3Forms, Getform…).
 * Fonctionne sans JS (soumission classique) ; avec JS : validation, envoi AJAX et états.
 * Le lien ?travaux=<clé> (ex. /contact/?travaux=isolation) pré-coche le type de travaux.
 */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const idleNote = "Réponse sous 48 h ouvrées. Pour une urgence (fuite, tuile envolée), appelez directement.";

const travaux = [
  { key: "couverture", label: "Couverture / toiture" },
  { key: "fuite", label: "Réparation / recherche de fuite" },
  { key: "demoussage", label: "Démoussage, hydrofuge, résine" },
  { key: "zinguerie", label: "Zinguerie, gouttières" },
  { key: "velux", label: "Fenêtre de toit (Velux)" },
  { key: "facade", label: "Façade / ravalement" },
  { key: "isolation", label: "Isolation" },
  { key: "etancheite", label: "Étanchéité toit-terrasse" },
  { key: "autre", label: "Autre" },
];
const projets = ["Rénovation", "Construction neuve", "Réparation urgente"];
const biens = ["Maison", "Appartement / copropriété", "Local professionnel"];
const delais = ["À préciser", "Urgent", "Dans le mois", "D'ici 3 mois", "Plus tard / je me renseigne"];
const creneaux = ["Indifférent", "Matin", "Midi", "Après-midi", "Soir"];
---

<form
  id="contact-form"
  action={endpoint || undefined}
  method="POST"
  novalidate
  data-endpoint={endpoint}
  data-phone={site.phone}
  class="flex flex-col gap-[clamp(28px,3vw,40px)] rounded-[22px] border border-line bg-white p-[clamp(22px,3vw,44px)] shadow-card"
  aria-labelledby="contact-form-titre"
>
  <div class="flex flex-col gap-2">
    <h2 id="contact-form-titre" class="text-[clamp(24px,2.6vw,30px)] font-extrabold tracking-[-0.022em]">
      Votre demande de devis
    </h2>
    <p class="text-[15px] text-muted-2">
      Les champs marqués <span class="font-semibold text-accent">*</span> sont obligatoires. 2 minutes suffisent.
    </p>
  </div>

  <!-- 1. Travaux -->
  <fieldset class="flex min-w-0 flex-col gap-5">
    <legend class="float-left flex w-full items-center gap-3 font-display text-[19px] font-bold">
      <span class="step-num" aria-hidden="true">01</span> Vos travaux
    </legend>

    <div class="flex flex-col gap-2.5">
      <span id="lbl-travaux" class="label"><span>Nature des travaux <span class="text-accent">*</span></span></span>
      <div
        class="choice-group grid-fit gap-2.5"
        style="--min:170px"
        role="group"
        aria-labelledby="lbl-travaux"
        aria-describedby="err-travaux"
        data-group="travaux"
      >
        {
          travaux.map((t) => (
            <label class="choice">
              <input type="checkbox" name="travaux" value={t.label} data-key={t.key} />
              {t.label}
            </label>
          ))
        }
      </div>
      <span id="err-travaux" class="hidden text-[13px] font-medium text-accent" data-error>
        Cochez au moins un type de travaux.
      </span>
    </div>

    <div class="grid-fit gap-5" style="--min:260px">
      <div class="flex flex-col gap-2.5">
        <span id="lbl-projet" class="label">Type de projet</span>
        <div class="flex flex-wrap gap-2" role="radiogroup" aria-labelledby="lbl-projet">
          {
            projets.map((p, i) => (
              <label class="choice py-2.5">
                <input type="radio" name="projet" value={p} checked={i === 0} />
                {p}
              </label>
            ))
          }
        </div>
      </div>
      <div class="flex flex-col gap-2.5">
        <span id="lbl-bien" class="label">Type de bien</span>
        <div class="flex flex-wrap gap-2" role="radiogroup" aria-labelledby="lbl-bien">
          {
            biens.map((b, i) => (
              <label class="choice py-2.5">
                <input type="radio" name="bien" value={b} checked={i === 0} />
                {b}
              </label>
            ))
          }
        </div>
      </div>
    </div>

    <div class="grid-fit gap-3.5" style="--min:220px">
      <label class="label">
        <span>Surface approximative <span class="optional">(m², facultatif)</span></span>
        <input class="field" type="number" name="surface" min="1" inputmode="numeric" placeholder="ex. 120" />
      </label>
      <label class="label">
        Délai souhaité
        <select class="field" name="delai">
          {delais.map((d) => <option>{d}</option>)}
        </select>
      </label>
    </div>

    <label class="label">
      <span>Décrivez votre projet <span class="optional">(facultatif)</span></span>
      <textarea
        class="field resize-y"
        name="message"
        rows="5"
        placeholder="Type de couverture (tuile, ardoise…), problème constaté, accès, questions…"></textarea>
    </label>
  </fieldset>

  <!-- 2. Chantier -->
  <fieldset class="flex min-w-0 flex-col gap-3.5 border-t border-rule pt-[clamp(24px,3vw,36px)]">
    <legend class="float-left flex w-full items-center gap-3 font-display text-[19px] font-bold">
      <span class="step-num" aria-hidden="true">02</span> Adresse du chantier
    </legend>
    <label class="label clear-both">
      <span>Adresse <span class="optional">(facultatif)</span></span>
      <input class="field" type="text" name="adresse" autocomplete="street-address" placeholder="N° et rue" />
    </label>
    <div class="grid-fit gap-3.5" style="--min:180px">
      <label class="label">
        <span>Code postal <span class="text-accent">*</span></span>
        <input
          class="field"
          type="text"
          name="code_postal"
          autocomplete="postal-code"
          inputmode="numeric"
          maxlength="5"
          placeholder="60140"
          required
          aria-describedby="err-cp"
        />
        <span id="err-cp" class="hidden text-[13px] font-medium text-accent" data-error>
          Code postal à 5 chiffres.
        </span>
      </label>
      <label class="label">
        <span>Commune <span class="text-accent">*</span></span>
        <input
          class="field"
          type="text"
          name="commune"
          autocomplete="address-level2"
          placeholder="Votre commune"
          required
          aria-describedby="err-commune"
        />
        <span id="err-commune" class="hidden text-[13px] font-medium text-accent" data-error>
          Merci d'indiquer la commune.
        </span>
      </label>
    </div>
  </fieldset>

  <!-- 3. Coordonnées -->
  <fieldset class="flex min-w-0 flex-col gap-3.5 border-t border-rule pt-[clamp(24px,3vw,36px)]">
    <legend class="float-left flex w-full items-center gap-3 font-display text-[19px] font-bold">
      <span class="step-num" aria-hidden="true">03</span> Vos coordonnées
    </legend>
    <div class="grid-fit clear-both gap-3.5" style="--min:220px">
      <label class="label">
        <span>Nom et prénom <span class="text-accent">*</span></span>
        <input
          class="field"
          type="text"
          name="nom"
          autocomplete="name"
          placeholder="Votre nom"
          required
          aria-describedby="err-nom"
        />
        <span id="err-nom" class="hidden text-[13px] font-medium text-accent" data-error>
          Merci d'indiquer votre nom.
        </span>
      </label>
      <label class="label">
        <span>Téléphone <span class="text-accent">*</span></span>
        <input
          class="field"
          type="tel"
          name="telephone"
          autocomplete="tel"
          inputmode="tel"
          placeholder="06 00 00 00 00"
          required
          pattern="^(?:(?:\+|00)33[\s.\-]?|0)[1-9](?:[\s.\-]?\d{2}){4}$"
          aria-describedby="err-tel"
        />
        <span id="err-tel" class="hidden text-[13px] font-medium text-accent" data-error>
          Numéro français attendu, ex. 06 12 34 56 78.
        </span>
      </label>
    </div>
    <div class="grid-fit gap-3.5" style="--min:220px">
      <label class="label">
        <span>E-mail <span class="optional">(facultatif)</span></span>
        <input
          class="field"
          type="email"
          name="email"
          autocomplete="email"
          placeholder="vous@exemple.fr"
          aria-describedby="err-email"
        />
        <span id="err-email" class="hidden text-[13px] font-medium text-accent" data-error>
          Adresse e-mail invalide.
        </span>
      </label>
      <label class="label">
        Meilleur moment pour vous rappeler
        <select class="field" name="creneau">
          {creneaux.map((c) => <option>{c}</option>)}
        </select>
      </label>
    </div>
  </fieldset>

  <div class="flex flex-col gap-4 border-t border-rule pt-[clamp(24px,3vw,36px)]">
    <label class="flex items-start gap-3 text-[14.5px] leading-[1.45] text-ink-5">
      <input
        type="checkbox"
        name="consentement"
        value="oui"
        required
        class="mt-0.5 size-[18px] flex-none accent-brand"
        aria-describedby="err-rgpd"
      />
      <span>
        J'accepte que mes informations soient utilisées pour traiter ma demande de devis. Elles ne sont ni cédées ni
        revendues (<a href="/mentions-legales/" class="underline underline-offset-2">en savoir plus</a>).
        <span class="text-accent">*</span>
      </span>
    </label>
    <span id="err-rgpd" class="-mt-2 hidden text-[13px] font-medium text-accent" data-error>
      Votre accord est nécessaire pour que nous puissions vous recontacter.
    </span>

    <!-- Anti-spam : champ invisible que seuls les robots remplissent. -->
    <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
      <label>Ne pas remplir <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>
    <input type="hidden" name="_subject" value="Nouvelle demande de devis (page contact) — site RAGOT" />

    <button
      type="submit"
      class="btn btn-navy w-full px-[22px] py-[18px] text-[17px] disabled:cursor-wait disabled:opacity-70 sm:w-max sm:px-10"
    >
      Envoyer ma demande de devis
    </button>
    <p class="text-sm leading-[1.45] text-muted-2" role="status" aria-live="polite" data-note>
      {idleNote}
    </p>
  </div>
</form>

<script>
  const PHONE_RE = /^(?:(?:\+|00)33[\s.\-]?|0)[1-9](?:[\s.\-]?\d{2}){4}$/;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    const note = form.querySelector<HTMLElement>("[data-note]")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const endpoint = form.dataset.endpoint ?? "";
    const phone = form.dataset.phone ?? "";
    const idle = note.textContent?.trim() ?? "";
    const buttonLabel = button.textContent?.trim() ?? "";

    // Pré-sélection depuis ?travaux=isolation (liens des pages métier).
    const preset = new URLSearchParams(location.search).get("travaux");
    if (preset) {
      const box = form.querySelector<HTMLInputElement>(`input[data-key="${CSS.escape(preset)}"]`);
      if (box) box.checked = true;
    }

    const setNote = (text: string, tone: "idle" | "ok" | "error") => {
      note.textContent = text;
      note.classList.toggle("text-accent", tone === "error");
      note.classList.toggle("font-semibold", tone !== "idle");
      note.classList.toggle("text-navy-800", tone === "ok");
      note.classList.toggle("text-muted-2", tone === "idle");
    };

    const showError = (el: HTMLElement, errorId: string, ok: boolean) => {
      el.setAttribute("aria-invalid", String(!ok));
      document.getElementById(errorId)?.classList.toggle("hidden", ok);
      return ok;
    };

    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const group = form.querySelector<HTMLElement>('[data-group="travaux"]')!;
    const boxes = [...group.querySelectorAll<HTMLInputElement>("input")];
    const consent = field("consentement");

    const checks: [HTMLElement, () => boolean][] = [
      [group, () => showError(group, "err-travaux", boxes.some((b) => b.checked))],
      [field("code_postal"), () => showError(field("code_postal"), "err-cp", /^\d{5}$/.test(field("code_postal").value.trim()))],
      [field("commune"), () => showError(field("commune"), "err-commune", field("commune").value.trim().length >= 2)],
      [field("nom"), () => showError(field("nom"), "err-nom", field("nom").value.trim().length >= 2)],
      [field("telephone"), () => showError(field("telephone"), "err-tel", PHONE_RE.test(field("telephone").value.trim()))],
      [field("email"), () => {
        const v = field("email").value.trim();
        return showError(field("email"), "err-email", v === "" || EMAIL_RE.test(v));
      }],
      [consent, () => showError(consent, "err-rgpd", consent.checked)],
    ];

    // Validation au fil de la saisie, une fois le champ quitté.
    for (const [el, check] of checks) {
      el.addEventListener(el === group || el === consent ? "change" : "blur", check);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const invalid = checks.filter(([, check]) => !check());
      if (invalid.length) {
        const first = invalid[0][0];
        (first === group ? boxes[0] : first).focus();
        first.scrollIntoView({ behavior: "smooth", block: "center" });
        setNote("Merci de vérifier les champs signalés.", "error");
        return;
      }

      const data = new FormData(form);
      if (data.get("_gotcha")) return; // robot

      // Plusieurs cases cochées → une seule valeur lisible dans l'e-mail reçu.
      const works = data.getAll("travaux").join(", ");
      data.delete("travaux");
      data.set("travaux", works);

      if (!endpoint) {
        setNote(`L'envoi en ligne est momentanément indisponible. Appelez-nous au ${phone}.`, "error");
        return;
      }

      button.disabled = true;
      button.textContent = "Envoi en cours…";
      setNote(idle, "idle");
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        setNote("Merci, votre demande est bien envoyée. Nous vous rappelons sous 48 h ouvrées.", "ok");
        button.textContent = "Demande envoyée";
      } catch {
        setNote(`L'envoi a échoué. Réessayez ou appelez-nous directement au ${phone}.`, "error");
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    });
  }
</script>
