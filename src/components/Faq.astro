---
/** FAQ accessible sans JavaScript (<details>) — balisée en FAQPage côté page. */
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = "Questions fréquentes" } = Astro.props;
---

<section class="wrap section-y" aria-labelledby="faq-titre">
  <div class="grid items-start gap-[clamp(24px,3vw,48px)] lg:grid-cols-[1fr_2fr]">
    <div class="flex flex-col gap-4">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq-titre" class="h2-sm">{title}</h2>
    </div>
    <div class="flex flex-col gap-3">
      {
        items.map((it) => (
          <details class="faq group rounded-2xl border border-line bg-white shadow-card open:border-lav-200">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-[22px] py-[18px] font-display text-[17px] font-bold tracking-[-0.01em] text-ink">
              <h3 class="text-[17px]">{it.q}</h3>
              <span
                class="grid size-7 flex-none place-items-center rounded-lg bg-lav-100 text-navy-800 transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="px-[22px] pb-5 text-base leading-relaxed text-ink-3">{it.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
