---
import type { NavKey } from "@/data/site";

/** Icônes des métiers : trait 24 px, couleur héritée (currentColor). */
interface Props {
  name: Exclude<NavKey, "" | "contact">;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "couverture" && (
      <>
        {/* Grand toit avec un rang de tuiles, cheminée, murs bas */}
        <path d="M2 14 12 4.5 22 14" />
        <path d="M6.5 11.2c.75 1.2 2.25 1.2 3 0 .75 1.2 2.25 1.2 3 0 .75 1.2 2.25 1.2 3 0 .75 1.2 2.25 1.2 3 0" />
        <path d="M16.6 7.9V4h2.6v6.4" />
        <path d="M5 15.5v5h14v-5" />
      </>
    )
  }
  {
    name === "facade" && (
      <>
        {/* Rouleau de peinture */}
        <rect x="3" y="3" width="15" height="6" rx="2" />
        <path d="M18 6h1.5A1.5 1.5 0 0 1 21 7.5v2A1.5 1.5 0 0 1 19.5 11H12a1.5 1.5 0 0 0-1.5 1.5V15" />
        <rect x="8.75" y="15" width="3.5" height="6.5" rx="1" />
      </>
    )
  }
  {
    name === "isolation" && (
      <>
        {/* Maison et thermomètre : confort thermique */}
        <path d="M2.5 11 12 3.5l9.5 7.5" />
        <path d="M5 9.2v11.3h14V9.2" />
        <path d="M11 15.2V10a1 1 0 0 1 2 0v5.2" />
        <circle cx="12" cy="16.9" r="2" />
        <path d="M15 11.5h1.5M15 13.5h1.5" />
      </>
    )
  }
  {
    name === "etancheite" && (
      <>
        {/* Goutte au-dessus d'un toit-terrasse avec relevés */}
        <path d="M12 2.5c1.9 2.4 3 4 3 5.4a3 3 0 0 1-6 0c0-1.4 1.1-3 3-5.4Z" />
        <path d="M3 11.5v2.5h18v-2.5" />
        <path d="M5 14v6.5h14V14" />
        <path d="M8 16.5h2.5v2H8zM13.5 16.5H16v2h-2.5z" />
      </>
    )
  }
</svg>
