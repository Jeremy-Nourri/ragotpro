---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import Photo from "@/components/Photo.astro";
import photoCamion from "@/assets/photos/photo-camion-chantier.jpg";
import { site } from "@/data/site";

const path = "/contact/";
const title = "Contact et demande de devis gratuit | RAGOT Couvreur Pro";
const description = `Demandez votre devis gratuit : couverture, réparation de toiture, façade et ravalement, isolation, étanchéité. Réponse sous 48 h, déplacement gratuit. ${site.phone}.`;

const etapes = [
  { t: "Nous vous rappelons", d: "Sous 48 h ouvrées, pour préciser votre besoin." },
  { t: "Visite sur place", d: "Diagnostic gratuit de la toiture ou de la façade." },
  { t: "Devis détaillé", d: "Poste par poste, gratuit et sans engagement." },
];

const a = site.address;
const locality = [a.postalCode, a.addressLocality].filter(Boolean).join(" ");
---

<BaseLayout
  title={title}
  description={description}
  active="contact"
  breadcrumbs={[{ name: "Contact", href: path }]}
  pageType="ContactPage"
  showCta={false}
>
  <section class="hero-bg on-dark text-white">
    <div class="intro wrap flex flex-col gap-[22px] pt-[clamp(28px,3.4vw,52px)] pb-[clamp(40px,5vw,72px)]">
      <nav aria-label="Fil d'Ariane">
        <ol class="flex flex-wrap gap-2 text-sm text-on-navy-2">
          <li><a href="/" class="text-on-navy-2 hover:text-white">Accueil</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page" class="text-white">Contact</span></li>
        </ol>
      </nav>
      <h1 class="max-w-[16em] text-[clamp(34px,4.6vw,58px)] leading-[1.05] font-extrabold tracking-[-0.025em] text-balance">
        Demande de devis gratuit
      </h1>
      <p class="max-w-[36em] text-[clamp(17px,1.5vw,20px)] leading-normal text-on-navy">
        Décrivez vos travaux en quelques clics : nous vous rappelons pour convenir d'une visite. Devis et déplacement
        gratuits, sans engagement.
      </p>
      <ul class="flex flex-wrap gap-2.5">
        <li class="pill">Réponse sous 48 h</li>
        <li class="pill">Déplacement gratuit</li>
        <li class="pill">Garantie décennale</li>
      </ul>
    </div>
  </section>

  <section class="wrap section-y">
    <div class="grid items-start gap-[clamp(24px,3vw,44px)] lg:grid-cols-[minmax(0,1.75fr)_minmax(0,1fr)]">
      <ContactForm />

      <aside class="flex flex-col gap-4" aria-label="Coordonnées">
        <div class="on-dark flex flex-col gap-4 rounded-[20px] bg-navy-900 p-[clamp(22px,2.6vw,32px)] text-white">
          <h2 class="text-[21px] font-bold tracking-[-0.015em]">Plus rapide : appelez-nous</h2>
          <p class="text-[15.5px] leading-normal text-on-navy">
            Fuite, tuile envolée, question rapide ? Un appel suffit pour fixer un rendez-vous.
          </p>
          <a
            href={site.phoneHref}
            class="btn btn-red w-full text-[clamp(19px,2vw,22px)]"
            aria-label={`Appeler ${site.name} au ${site.phone}`}
          >
            {site.phone}
          </a>
          <span class="text-sm text-on-navy-2">{site.openingHours.label}</span>
        </div>

        <address class="card-sm gap-3 not-italic">
          <h2 class="font-display text-sm font-extrabold tracking-[0.04em] text-brand">COORDONNÉES</h2>
          <dl class="flex flex-col gap-3 text-[15.5px] leading-[1.45] text-ink-3">
            {
              site.email && (
                <div>
                  <dt class="text-[13px] font-semibold text-muted">E-mail</dt>
                  <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
                </div>
              )
            }
            {
              (a.streetAddress || locality) && (
                <div>
                  <dt class="text-[13px] font-semibold text-muted">Adresse</dt>
                  <dd>
                    {a.streetAddress && <span class="block">{a.streetAddress}</span>}
                    {locality && <span class="block">{locality}</span>}
                  </dd>
                </div>
              )
            }
            <div>
              <dt class="text-[13px] font-semibold text-muted">Zone d'intervention</dt>
              <dd class="first-letter:uppercase">{site.zone}</dd>
            </div>
          </dl>
        </address>

        <div class="card-sm gap-4">
          <h2 class="font-display text-sm font-extrabold tracking-[0.04em] text-brand">ET ENSUITE ?</h2>
          <ol class="flex flex-col gap-3.5">
            {
              etapes.map((e, i) => (
                <li class="flex gap-3">
                  <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <span class="flex flex-col gap-0.5">
                    <span class="font-display text-[15.5px] font-bold text-ink">{e.t}</span>
                    <span class="text-[14.5px] leading-[1.45] text-ink-5">{e.d}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>

        <figure class="flex flex-col gap-2.5">
          <div class="photo">
            <Photo
              src={photoCamion}
              alt="Camion RAGOT Couvreur Pro garé devant une maison, en intervention"
              variant="half"
            />
          </div>
          <figcaption class="text-[14.5px] font-semibold text-ink-5">Notre camion, bientôt devant chez vous</figcaption>
        </figure>
      </aside>
    </div>
  </section>
</BaseLayout>
